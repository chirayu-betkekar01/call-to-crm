# Copy to .env and fill in. Never commit .env.

# --- Step 1 + 2 (LLM) -------------------------------------------------------
OPENROUTER_API_KEY=
# Any OpenRouter model id. Default is anthropic/claude-sonnet-5.5.
OPENROUTER_MODEL=

# --- Source -----------------------------------------------------------------
# Fathom: Settings -> API Access -> Generate API key
FATHOM_API_KEY=
# Your own company's email domains (comma-separated) -> people on them are tagged "internal"
INTERNAL_DOMAINS=
OUTPUT_DIR=output

# --- Step 2: buying roles (optional overrides) ------------------------------
# BUYING_ROLES=decision_maker,champion,blocker
# ROLE_MIN_CONFIDENCE=0.6

# --- Step 3a: enrichment ----------------------------------------------------
# mock   = free, offline, clearly-fake demo data (default)
# hunter = Hunter Email Finder API, free plan works (hunter.io -> API -> API key)
# apollo = Apollo People Match API, needs a paid Apollo plan
ENRICHER=mock
HUNTER_API_KEY=
APOLLO_API_KEY=
# MAX_ENRICH=25

# --- Step 3b: HubSpot sync --------------------------------------------------
# HubSpot -> Development -> Service keys. Scopes: see README "HubSpot setup".
# No leading '#' on the real line, or the token is commented out.
HUBSPOT_TOKEN=
